# Copy this file to .env and fill in real values. Never commit .env to git.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database: set DB_ENGINE=sqlite for zero-config local dev,
# or DB_ENGINE=mysql to use MySQL (recommended for production).
DB_ENGINE=sqlite
DB_NAME=tea_shop
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Business settings
DELIVERY_FEE=30
FREE_DELIVERY_THRESHOLD=499
